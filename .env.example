# Generate ONCE with:
#   openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 32 ; echo
# Never change after first deploy — it encrypts existing addon configs,
# changing it invalidates every previously generated user URL.
PRIVATE_ENCRYPTION_KEY=replace_me_with_a_32_char_random_string

# Public URL where this addon is reachable. Used by the addon to generate
# correct Stremio install links. NO trailing slash.
ORIGIN=https://syncribullet.example.com

# Host port to bind on loopback. Default: 3050.
# SYNCRIBULLET_PORT=3050

# Optional: receive a POST notification when the TV Time refresh token
# itself expires and the user must re-authenticate in the addon UI.
# Body shape: {source, event, user, reason}. Works with ntfy.sh, Discord
# webhooks, n8n, or any HTTP POST receiver.
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-private-topic

# Optional: log every axios-cache-interceptor event to stdout as
# single-line JSON. Useful for diagnosing cache misses; off by default
# because it dilutes the structured [tvtime] log stream.
# AXIOS_CACHE_DEBUG=1

# Optional: switch logTVTime output from logfmt to JSON for log shippers.
# LOG_FORMAT=json
